{
  "name": "vigia-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST y base de datos de VigiaApp (Express 5 + Drizzle + MySQL/MariaDB)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "npm run hostinger:build",
    "hostinger:install": "npm ci",
    "hostinger:build": "npm run compile && npm run db:migrate:prod",
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/src/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "invitar": "node --env-file-if-exists=.env scripts/invitar.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "yaml": "^2.9.1"
  }
}
