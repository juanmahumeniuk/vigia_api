# Copiar a .env para desarrollo local. En Hostinger, cargar estas variables en hPanel (nunca en el repo).
NODE_ENV=development
PORT=3000

# En Hostinger: 127.0.0.1 (no "localhost", que puede resolver a IPv6 y fallar el grant).
DATABASE_URL=mysql://vigia:vigia@127.0.0.1:3307/vigia_dev
# Base aparte para `npm test` (se BORRAN sus tablas en cada corrida).
TEST_DATABASE_URL=mysql://root:vigia@127.0.0.1:3307/vigia_test
DB_POOL_LIMIT=5

# Detrás del proxy de Hostinger: 1. Necesario para que el rate limit vea la IP real.
TRUST_PROXY=1

# Zona horaria del barrio: define "el lunes de esta semana" en /rondines/semana.
BARRIO_TZ=America/Argentina/Buenos_Aires

# Enlace que va en los correos de invitación/recuperación: se le agrega ?token=<64 hex>.
# Puede ser un deep link de la app (vigiaapp://clave) o una página web.
APP_URL_CLAVE=vigiaapp://clave

# SMTP. Sin SMTP_HOST (solo fuera de producción) los correos se imprimen en consola.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VigiaApp <no-reply@example.com>"

# Límite de pedidos a /auth/* por IP cada 15 minutos.
AUTH_RATE_LIMIT_MAX=20
